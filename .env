# Production Environment Template
# Copy to .env and fill in actual values

# ==================== DATABASE ====================
USE_SQLITE=false
DATABASE_URL=postgresql://petpooja:password@localhost:5432/rdios_db
DB_PASSWORD=YOUR_SECURE_PASSWORD

# ==================== AUTHENTICATION ====================
# CRITICAL: Generate a secure 32+ character random key
JWT_SECRET_KEY=YOUR_32_CHAR_RANDOM_SECRET_KEY_HERE

# ==================== REDIS ====================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==================== CELERY ====================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==================== TWILIO (WhatsApp) ====================
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ==================== EMAIL ====================
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@rdios.com
FROM_NAME=R-DIOS

# ==================== EXTERNAL APIS ====================
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== MONITORING ====================
GRAFANA_PASSWORD=YOUR_SECURE_GRAFANA_PASSWORD
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ==================== SECURITY ====================
# Debug should ALWAYS be false in production
DEBUG=false
SQL_ECHO=false
ALLOWED_HOSTS=api.rdios.com,rdios.com

# ==================== RATE LIMITING ====================
WHATSAPP_DAILY_BUDGET=500
WHATSAPP_CUSTOMER_DAILY_LIMIT=3
WHATSAPP_SYSTEM_DAILY_LIMIT=1000
API_RATE_LIMIT_PER_MINUTE=100

# ==================== AI ASSISTANT ====================
# Google Gemini API for multilingual AI assistant
# Get your free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AizaSyDuCMsUxEPZILYAxUDt9l_HukMqxHr57Mk