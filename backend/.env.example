# Database (Replace with your own credentials)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379/0

# AI/ML (Ollama for local free AI, or Cloud Fallbacks)
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ibm/granite3.3:2b-base
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key

# Email (SMTP for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# WhatsApp (MSG91 integration)
MSG91_API_KEY=your_msg91_key
MSG91_SENDER_ID=RDIOS_MSG

# Security - JWT (Change these in production!)
JWT_SECRET_KEY=generate_a_long_random_string_using_openssl_rand_hex_32
JWT_ALGORITHM=HS256

# Feature Flags
ENABLE_AI_ASSISTANT=true
ENABLE_EMAIL=true
ENABLE_WHATSAPP=false
