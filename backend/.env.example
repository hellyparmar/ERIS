# ═══════════════════════════════════════════════════════════════════════════════
# BACKEND ENVIRONMENT CONFIGURATION - TEMPLATE
# ═══════════════════════════════════════════════════════════════════════════════
#
# ⚠️  CRITICAL SECURITY NOTICE:
# - Copy this file to backend/.env
# - NEVER commit backend/.env to version control
# - NEVER hardcode real credentials in source code
# - Use strong, unique passwords for production
# - Store production secrets in AWS Secrets Manager / Vault / Key Vault
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL recommended for production)
# ─────────────────────────────────────────────────────────────────────────────
#
# Format: postgresql+asyncpg://[user]:[password]@[host]:[port]/[database]
# Local dev: sqlite:///./eris_dev.sqlite3
#
# Generate strong password: openssl rand -base64 32

DATABASE_URL=postgresql+asyncpg://[db_user]:[db_password]@localhost:5432/enterprise_retail
TEST_DATABASE_URL=sqlite:///./test_eris.sqlite3

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ─────────────────────────────────────────────────────────────────────────────
#
# Generate JWT secret: openssl rand -hex 32
# Keep ABSOLUTELY SECRET in production

JWT_SECRET_KEY=[GENERATE_WITH: openssl rand -hex 32]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# ─────────────────────────────────────────────────────────────────────────────
# REDIS (Caching, Sessions & Celery)
# ─────────────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=4

# ─────────────────────────────────────────────────────────────────────────────
# API CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=3.0.0
WORKERS=4

# ─────────────────────────────────────────────────────────────────────────────
# EXTERNAL APIS (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# Weather (openweathermap.org)
OPENWEATHER_API_KEY=[OPTIONAL]

# AI/LLM Keys
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ibm/granite3.3:2b-base
OPENAI_API_KEY=[OPTIONAL]
ANTHROPIC_API_KEY=[OPTIONAL]
GEMINI_API_KEY=[OPTIONAL]
GROQ_API_KEY=[OPTIONAL]
OPENROUTER_API_KEY=[OPTIONAL]

# SMS & Messaging (msg91.com)
MSG91_API_KEY=[OPTIONAL]
MSG91_SENDER_ID=[OPTIONAL]

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

ENABLE_HTTPS=false
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ─────────────────────────────────────────────────────────────────────────────
# TALLY ERP INTEGRATION
# ─────────────────────────────────────────────────────────────────────────────
# Tally runs a built-in web server on port 9000
# Configure the host/port where Tally is running
TALLY_HOST=localhost
TALLY_PORT=9000

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────

ENABLE_AI_ASSISTANT=true

# ═══════════════════════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Copy this file to backend/.env:
#    cp backend/.env.example backend/.env
#
# 2. Replace all placeholder values with actual configuration
#
# 3. Set restrictive permissions:
#    chmod 600 backend/.env
#
# 4. Verify git will not commit:
#    git check-ignore -v backend/.env
#    # Should output: backend/.env
#
# 5. Test the connection:
#    cd backend && python -c "from app.core.config import settings; print('✅ Config loaded')"
#
# ═══════════════════════════════════════════════════════════════════════════════
