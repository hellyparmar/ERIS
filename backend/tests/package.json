{
    "name": "rdios-testing",
    "version": "1.0.0",
    "description": "E2E and load testing for R-DIOS",
    "scripts": {
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:chromium": "playwright test --project chromium",
        "test:e2e:firefox": "playwright test --project firefox",
        "test:e2e:webkit": "playwright test --project webkit",
        "test:e2e:mobile": "playwright test --project mobile-chrome --project mobile-safari",
        "test:e2e:offline": "playwright test --project offline-chromium",
        "test:e2e:report": "playwright show-report test-results/html",
        "test:load:normal": "k6 run tests/load/normal_load.js",
        "test:load:peak": "k6 run tests/load/peak_load.js",
        "test:load:stress": "k6 run tests/load/stress_test.js",
        "test:load:all": "npm run test:load:normal && npm run test:load:peak",
        "test:performance": "npm run test:load:normal -- --out json=test-results/load-normal.json",
        "test:all": "npm run test:e2e && npm run test:load:normal",
        "install:browsers": "playwright install"
    },
    "devDependencies": {
        "@playwright/test": "^1.40.0",
        "typescript": "^5.3.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}