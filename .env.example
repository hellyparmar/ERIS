# =============================================================================
# ERIS – Environment Variable Template
# =============================================================================
# 1. Copy to .env:  cp .env.example .env
# 2. Fill every CHANGE_ME value before running the app.
# 3. NEVER commit .env – it is in .gitignore.
# 4. For production use a secrets manager (AWS Secrets Manager, Vault, etc.)
# =============================================================================

# -- Application ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# -- Database ------------------------------------------------------------------
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# For local dev you may use: sqlite+aiosqlite:///./eris_dev.db
DATABASE_URL=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
POSTGRES_PORT=5432

# -- Auth / JWT ----------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# -- Redis / Celery ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=4

# -- CORS ----------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -- Webhooks ------------------------------------------------------------------
# Secret shared with n8n – generate with:  openssl rand -hex 20
N8N_WEBHOOK_SECRET=CHANGE_ME

# -- Feature flags -------------------------------------------------------------
ENABLE_AI_ASSISTANT=true
ENABLE_WHATSAPP=false

# -- AI / LLM ------------------------------------------------------------------
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ibm/granite3.3:2b-base

# Fill whichever providers you want as fallback (leave blank to disable):
OPENAI_API_KEY=CHANGE_ME_OR_LEAVE_BLANK
ANTHROPIC_API_KEY=CHANGE_ME_OR_LEAVE_BLANK
GROQ_API_KEY=CHANGE_ME_OR_LEAVE_BLANK
GEMINI_API_KEY=CHANGE_ME_OR_LEAVE_BLANK
OPENROUTER_API_KEY=CHANGE_ME_OR_LEAVE_BLANK

# -- External APIs (optional) --------------------------------------------------
OPENWEATHER_API_KEY=CHANGE_ME_OR_LEAVE_BLANK

# -- Messaging / Notifications -------------------------------------------------
MSG91_API_KEY=CHANGE_ME_OR_LEAVE_BLANK
MSG91_SENDER_ID=CHANGE_ME_OR_LEAVE_BLANK

# -- Load testing (only used by tests/load_testing.py) ------------------------
TEST_ADMIN_PASSWORD=CHANGE_ME
TEST_MANAGER_PASSWORD=CHANGE_ME

# -- API Server ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4

# -- Tally ERP Integration -----------------------------------------------------
TALLY_HOST=localhost
TALLY_PORT=9000

# -- Security -----------------------------------------------------------------
ENABLE_HTTPS=false
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
