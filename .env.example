# ═══════════════════════════════════════════════════════════════
# PostgreSQL Database Configuration
# ═══════════════════════════════════════════════════════════════

# Database credentials
POSTGRES_USER=eris_admin
POSTGRES_PASSWORD=admin1234
POSTGRES_DB=eris_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Constructed database URL (must match format for asyncpg)
DATABASE_URL=postgresql+asyncpg://eris_admin:admin1234@localhost:5432/eris_production

# ═══════════════════════════════════════════════════════════════
# Application Configuration
# ═══════════════════════════════════════════════════════════════

ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME=R-DIOS
DEBUG=false

# ═══════════════════════════════════════════════════════════════
# Database Connection Pool
# ═══════════════════════════════════════════════════════════════

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ═══════════════════════════════════════════════════════════════
# Redis Configuration
# ═══════════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════════
# API Configuration
# ═══════════════════════════════════════════════════════════════

API_TITLE=R-DIOS API
API_VERSION=1.0.0
API_DESCRIPTION=Retail Demand Intelligence & Operations System

# ═══════════════════════════════════════════════════════════════
# Security Settings
# ═══════════════════════════════════════════════════════════════

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ═══════════════════════════════════════════════════════════════
# CORS Settings
# ═══════════════════════════════════════════════════════════════

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ═══════════════════════════════════════════════════════════════
# NOTE: 
# - This file MUST be listed in .gitignore to prevent accidental commits
# - Never commit actual credentials to version control
# - Copy .env.example to .env and update with your values
# ═══════════════════════════════════════════════════════════════
