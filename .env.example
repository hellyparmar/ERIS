# ERIS configuration template
# Copy this file to .env at the repository root. Never commit the populated file.

# Runtime
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database
# Local zero-setup option: sqlite+aiosqlite:///./eris_dev.sqlite3
# Production: paste the complete connection URL from your PostgreSQL provider.
DATABASE_URL=CHANGE_ME
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=3600

# Authentication (required; application fails fast when absent)
# JWT: generate an unpredictable value of at least 32 bytes.
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Browser/API connection
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://127.0.0.1:8000
VITE_API_TIMEOUT=30000

# Demo dataset generation
ERIS_SEED_PASSWORD=CHANGE_ME
ERIS_DEMO_DATA_SEED=42

# AI assistant (Ollama is local and requires no API key)
ENABLE_AI_ASSISTANT=true
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_REQUEST_TIMEOUT_SECONDS=60

# Optional hosted AI fallbacks; leave blank to disable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
