# Copy to api/.env and adjust. Every setting has a sensible default - the API runs without this file.

# Database: SQLite (default, zero setup) or PostgreSQL. The schema is created/upgraded by Alembic on start.
# DATABASE_URL=sqlite:///./data/eris.db
# DATABASE_URL=postgresql+psycopg2://eris:eris@localhost:5432/eris

# Change this in any shared deployment (python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Synthetic demo data, generated on first start when the database is empty (same seed + end date = same data)
SEED_DEMO_DATA=true
SEED_DAYS=730
SEED_OUTLETS=5
SEED_RANDOM_STATE=42
# SEED_END_DATE=2026-09-30   # default: yesterday in the organisation's time zone (the demo then moves forward daily)

# Start with your own data instead: no demo, and the first admin is created on an empty database.
# (Or run: python -m app.manage create-admin --email owner@shop.in --name "Owner" --org "My Shop")
# SEED_DEMO_DATA=false
# INITIAL_ADMIN_EMAIL=owner@shop.in
# INITIAL_ADMIN_PASSWORD=choose-a-strong-password

# Optional free local LLM for the AI assistant (https://ollama.com):  ollama pull llama3.2:3b
# The assistant works fully without it (structured mode). Check the chosen model's licence separately.
LLM_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
