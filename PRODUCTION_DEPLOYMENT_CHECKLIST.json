  "deployment_steps": {
    "section": "Step-by-Step Deployment Process",
    "phase_1": {
      "title": "Phase 1: Environment Preparation",
      "steps": [
        {
          "step": 1,
          "task": "Set up production environment variables",
          "commands": [
            "cp .env.production.example .env.production",
            "Edit .env.production with production values",
            "Validate DATABASE_URL, API_KEY, JWT_SECRET"
          ],
          "verification": "All environment variables set correctly"
        },
        {
          "step": 2,
          "task": "Configure production database",
          "commands": [
            "Create PostgreSQL database (recommended)",
            "Run migrations: alembic upgrade head",
            "Load initial data if needed"
          ],
          "verification": "Database connected, tables created, data loaded"
        },
        {
          "step": 3,
          "task": "Set up SSL certificates",
          "commands": [
            "Obtain SSL certificate (Let's Encrypt recommended)",
            "Configure web server with SSL",
            "Redirect HTTP to HTTPS"
          ],
          "verification": "HTTPS accessible, SSL valid"
        }
      ]
    },
    "phase_2": {
      "title": "Phase 2: Application Deployment",
      "steps": [
        {
          "step": 4,
          "task": "Deploy backend API",
          "commands": [
            "git clone/pull repository",
            "pip install -r requirements.txt",
            "uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 4",
            "Or use: gunicorn -w 4 -b 0.0.0.0:8000 api.main:app"
          ],
          "verification": "API responds to /api/v1/health"
        },
        {
          "step": 5,
          "task": "Deploy frontend application",
          "commands": [
            "npm install",
            "npm run build",
            "Serve dist/ folder with web server (nginx/Apache)"
          ],
          "verification": "Frontend accessible at domain, loads without errors"
        },
        {
          "step": 6,
          "task": "Configure reverse proxy",
          "note": "Example nginx configuration",
          "config": [
            "upstream api { server localhost:8000; }",
            "server { listen 443 ssl; server_name yourdomain.com; ssl_certificate ...; ssl_certificate_key ...; location /api { proxy_pass http://api; proxy_set_header Authorization $http_authorization; } location / { root /var/www/dist; try_files $uri $uri/ /index.html; } }"
          ],
          "verification": "Both frontend and API accessible through reverse proxy"
        }
      ]
    },
    "phase_3": {
      "title": "Phase 3: Post-Deployment Verification",
      "steps": [
        {
          "step": 7,
          "task": "Test API endpoints in production",
          "tests": [
            "curl https://yourdomain.com/api/v1/health",
            "curl https://yourdomain.com/api/v1/dashboard/realtime -H 'Authorization: Bearer TOKEN'",
            "curl https://yourdomain.com/api/v1/inventory/list -H 'Authorization: Bearer TOKEN'"
          ],
          "verification": "All endpoints return 200 OK with expected data"
        },
        {
          "step": 8,
          "task": "Test frontend in production",
          "tests": [
            "Visit https://yourdomain.com in browser",
            "Login with production credentials",
            "Navigate all pages",
            "Verify data loads and displays correctly"
          ],
          "verification": "All pages load, data displays, no console errors"
        },
        {
          "step": 9,
          "task": "Run smoke tests",
          "tests": [
            "Test user authentication flow",
            "Verify data integrity end-to-end",
            "Check API response times < 500ms",
            "Verify CORS headers present"
          ],
          "verification": "All smoke tests pass"
