# Production Environment Configuration
# Copy to .env.production and fill in actual values

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=eris_prod_user
DB_PASSWORD=change_me_secure_password_32_chars_min_!!!
DB_NAME=eris_production
DATABASE_URL=postgresql://eris_prod_user:change_me_secure_password_32_chars_min_!!!@postgres:5432/eris_production

# ============================================================================
# API Configuration
# ============================================================================
API_TITLE=Enterprise Retail Intelligence System
API_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change_me_with_secure_random_string_at_least_32_characters_long!!!
JWT_EXPIRY=86400

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_secure_redis_password_!!!
REDIS_DB=0

# ============================================================================
# RAG/LLM Configuration
# ============================================================================
RAG_USE_OLLAMA=true
RAG_OLLAMA_HOST=http://ollama:11434
RAG_MODEL=mistral
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_HOST=chromadb
VECTOR_DB_PORT=8000
VECTOR_DB_PATH=/app/data/chroma_db

# ============================================================================
# Causal Analysis Configuration
# ============================================================================
ENABLE_CAUSAL_ANALYSIS=true
CAUSAL_CACHE_DIR=/app/data/causal_cache
CAUSAL_BOOTSTRAP_SAMPLES=1000

# ============================================================================
# Forecasting Configuration
# ============================================================================
PROPHET_SEASONALITY_MODE=multiplicative
PROPHET_CHANGEPOINT_PRIOR_SCALE=0.05
ARIMA_ORDER_SELECTION=auto
LSTM_EPOCHS=100
LSTM_BATCH_SIZE=32
LSTM_LOOKBACK_DAYS=90
ENABLE_TRANSFER_LEARNING=true
ENABLE_ADAPTIVE_ENSEMBLE=true
ENSEMBLE_UPDATE_FREQUENCY_HOURS=168

# ============================================================================
# Alerting Configuration
# ============================================================================
ENABLE_ALERTS=true
ALERT_WEBHOOK_TIMEOUT=5
ALERT_DEDUP_WINDOW=3600
ALERT_RETENTION_DAYS=90

ENABLE_EMAIL_ALERTS=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=alerts@eris.local
SMTP_TLS=true

ENABLE_SLACK_ALERTS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

ENABLE_WEBHOOK_ALERTS=true
WEBHOOK_SECRET=your_webhook_secret_key

# ============================================================================
# Authentication & Security
# ============================================================================
ALLOWED_HOSTS=api.eris.local,eris.local,localhost
CORS_ORIGINS=https://eris.local,https://www.eris.local
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ============================================================================
# Monitoring & Observability
# ============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

LOGGING_LEVEL=INFO
LOGGING_FORMAT=json
LOG_FILE=/var/log/eris/app.log

# ============================================================================
# Grafana Configuration
# ============================================================================
GRAFANA_PASSWORD=change_me_secure_grafana_password_!!!
GRAFANA_ADMIN_USER=admin
GRAFANA_PROVISIONING_ENABLED=true

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_POOL=prefork
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups
BACKUP_CLOUD_ENABLED=true
BACKUP_CLOUD_PROVIDER=s3
AWS_S3_BUCKET=eris-backups-prod
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_CAUSAL_ANALYSIS=true
FEATURE_MULTI_OUTLET=true
FEATURE_REAL_TIME_ALERTS=true
FEATURE_ADAPTIVE_ENSEMBLE=true
FEATURE_TRANSFER_LEARNING=true
FEATURE_ADVANCED_ANALYTICS=true

# ============================================================================
# Performance Configuration
# ============================================================================
WORKER_PROCESSES=4
WORKER_THREADS=8
MAX_POOL_SIZE=20
DATABASE_POOL_SIZE=10
DATABASE_POOL_RECYCLE=3600
CACHE_TTL_SECONDS=300

# ============================================================================
# Maintenance Windows
# ============================================================================
MAINTENANCE_WINDOW_START=02:00
MAINTENANCE_WINDOW_END=03:00
MAINTENANCE_WINDOW_TIMEZONE=UTC
