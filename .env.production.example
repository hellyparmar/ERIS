# Production Environment Variables
# Copy this file to .env.production and fill in your values

# API Configuration
VITE_API_URL=https://rdios-api.up.railway.app
VITE_ENV=production

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Analytics
VITE_ANALYTICS_ENDPOINT=https://analytics.yourdomain.com/api/events

# Sentry (Error Tracking)
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Service Worker
VITE_SW_ENABLED=true

# Cache Configuration
VITE_CACHE_VERSION=1.0.0
VITE_API_CACHE_TIME=300000

# Build Configuration
VITE_BUILD_TIME=__BUILD_TIME__
VITE_VERSION=1.0.0
