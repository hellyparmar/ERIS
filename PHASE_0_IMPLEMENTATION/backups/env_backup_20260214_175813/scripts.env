# Migration Configuration
SOURCE_DATABASE=petpooja_retail_db.sqlite3
DESTINATION_DATABASE=postgresql://postgres:SecurePassword123@localhost:5433/enterprise_retail

# Migration Settings
BATCH_SIZE=1000
SKIP_VALIDATION=false
ROLLBACK_ENABLED=true
LOG_PROGRESS=true

# Performance
CONNECTION_TIMEOUT=30
STATEMENT_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=migration.log
