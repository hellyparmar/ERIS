# Backend Configuration
# Database Connection
DATABASE_URL=postgresql://postgres:SecurePassword123@localhost:5433/enterprise_retail
TEST_DATABASE_URL=postgresql://postgres:SecurePassword123@localhost:5433/enterprise_retail_test

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG
API_PORT=8000
WORKERS=4
DEBUG=True

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production-256-bits-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Pagination
ENABLE_PAGINATION=true
PAGINATION_DEFAULT_LIMIT=50
PAGINATION_MAX_LIMIT=500

# Caching
ENABLE_CACHING=true
CACHE_TTL_SECONDS=300

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=8001

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Feature Flags
ENABLE_FIFO_TRACKING=true
ENABLE_ALERTS=true
ENABLE_POS_INTEGRATION=true
